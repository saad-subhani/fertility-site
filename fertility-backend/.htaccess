Options -Indexes
RewriteEngine On
# Deny all private files even if they exist. Route only explicitly allowed APIs/uploads.
RewriteRule ^(?:\.|config/|lib/|vendor/|scripts/|tests/|migrations/|composer\.|database\.sql|README) - [F,L,NC]
RewriteRule ^api/(?:book|admin/(?:login|bookings|booking-detail|update-status|appointment|resend-email))\.php$ - [L]
RewriteRule ^uploads/payments/pay_[a-zA-Z0-9_]+\.(?:jpg|png|webp|gif)$ - [L]
RewriteRule ^ - [F,L]
