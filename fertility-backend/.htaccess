# Apache – enable if using XAMPP / Apache
RewriteEngine On

# CORS preflight
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Serve uploads
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^uploads/ - [L]

# Route API
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api/$1 [L,QSA]
